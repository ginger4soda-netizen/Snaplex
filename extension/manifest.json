{
  "manifest_version": 3,
  "name": "Snaplex",
  "version": "0.1.0",
  "description": "Capture visual references from the browser into Snaplex Desktop.",
  "permissions": [
    "contextMenus",
    "storage",
    "activeTab",
    "scripting",
    "tabs",
    "nativeMessaging"
  ],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": [
        "https://*.xiaohongshu.com/*",
        "https://*.xhscdn.com/*"
      ],
      "js": ["content/xhs/xhs-hover.js"],
      "css": ["content/xhs/xhs-hover.css"],
      "run_at": "document_idle",
      "world": "ISOLATED"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["content/xhs/snake-mark.png"],
      "matches": [
        "https://*.xiaohongshu.com/*",
        "https://*.xhscdn.com/*"
      ]
    }
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Snaplex"
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "commands": {
    "start-region-screenshot": {
      "description": "Start region screenshot"
    }
  }
}
